{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "build",
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "noEmitOnError": true
  },
  "include": [
    "src/**/*.ts",
    "bin/**/*.ts",
    "adapters/**/*.ts",
    "scripts/**/*.ts"
  ]
}
