diff --git a/crates/cadabra/src/local.rs b/crates/cadabra/src/local.rs
new file mode 100644
--- /dev/null
+++ b/crates/cadabra/src/local.rs
@@ -0,0 +1,79 @@
+//! Local control transport: Unix sockets or owner-only Windows named pipes.
+#[cfg(unix)]
+pub use tokio::net::{UnixListener as LocalListener, UnixStream as LocalStream};
+
+#[cfg(windows)]
+mod windows {
+    use interprocess::{
+        local_socket::{tokio::{prelude::*, Listener, Stream, RecvHalf, SendHalf}, GenericNamespaced, ListenerOptions, ToNsName},
+        os::windows::{local_socket::ListenerOptionsExt, security_descriptor::SecurityDescriptor},
+    };
+    use std::{io, path::Path};
+
+    fn name(path: &Path) -> io::Result<String> {
+        // Canonicalize the existing parent to give all callers the same pipe.
+        let parent = path.parent().ok_or_else(|| io::Error::other("missing control root"))?.canonicalize()?;
+        let text = parent.to_string_lossy().to_lowercase();
+        Ok(format!("abra-{}", abra_core::cas::Hash::of(text.as_bytes())))
+    }
+
+    pub struct LocalListener(Listener);
+    pub struct LocalStream(Stream);
+    impl LocalListener {
+        pub fn bind(path: &Path) -> io::Result<Self> {
+            let name = name(path)?;
+            let sddl = widestring::U16CString::from_str("D:P(D;;GA;;;NU)(A;;GA;;;OW)").map_err(io::Error::other)?;
+            let sd = SecurityDescriptor::deserialize(&sddl)?;
+            Ok(Self(ListenerOptions::new().name(name.to_ns_name::<GenericNamespaced>()?)
+                .security_descriptor(sd).create_tokio()?))
+        }
+        pub async fn accept(&self) -> io::Result<(LocalStream, ())> {
+            Ok((LocalStream(self.0.accept().await?), ()))
+        }
+    }
+    impl LocalStream {
+        pub async fn connect(path: impl AsRef<Path>) -> io::Result<Self> {
+            let name = name(path.as_ref())?;
+            Ok(Self(Stream::connect(name.to_ns_name::<GenericNamespaced>()?).await?))
+        }
+        pub fn into_split(self) -> (RecvHalf, SendHalf) { self.0.split() }
+    }
+}
+#[cfg(windows)]
+pub use windows::{LocalListener, LocalStream};
+
+#[cfg(all(test, windows))]
+mod tests {
+    use super::*;
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    #[tokio::test]
+    async fn pipe_round_trip_isolated_by_root() {
+        let root = tempfile::tempdir().unwrap();
+        let other = tempfile::tempdir().unwrap();
+        let socket = root.path().join("cadabra.sock");
+        let listener = LocalListener::bind(&socket).unwrap();
+        assert!(LocalListener::bind(&socket).is_err());
+        assert!(LocalStream::connect(other.path().join("cadabra.sock")).await.is_err());
+        let server = tokio::spawn(async move {
+            for _ in 0..2 {
+                let (stream, _) = listener.accept().await.unwrap();
+                let (mut read, mut write) = stream.into_split();
+                let mut request = [0; 4];
+                read.read_exact(&mut request).await.unwrap();
+                assert_eq!(&request, b"ping");
+                write.write_all(b"pong").await.unwrap();
+                write.flush().await.unwrap();
+            }
+        });
+        for _ in 0..2 {
+            let (mut read, mut write) = LocalStream::connect(&socket).await.unwrap().into_split();
+            write.write_all(b"ping").await.unwrap();
+            write.flush().await.unwrap();
+            let mut response = [0; 4];
+            read.read_exact(&mut response).await.unwrap();
+            assert_eq!(&response, b"pong");
+        }
+        server.await.unwrap();
+    }
+}
