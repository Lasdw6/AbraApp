+/// Unix needs directory fsync after rename. Windows does not support opening
+/// directories this way; file contents are flushed before the atomic rename.
+pub(crate) fn sync_directory(path: &Path) -> Result<()> {
+    #[cfg(unix)]
+    fs::File::open(path).and_then(|file| file.sync_all()).map_err(|error| Error::io(path, error))?;
+    #[cfg(not(unix))]
+    let _ = path;
+    Ok(())
+}
