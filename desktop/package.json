{
  "name": "abra-teleport",
  "version": "0.3.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run typecheck && cargo build --release --manifest-path ../abra/Cargo.toml -p abra-cli && bash ../abra-teleport/scripts/package-agent.sh && npm run build && electron-builder --mac dir",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.5"
  },
  "build": {
    "appId": "dev.abra.teleport",
    "productName": "Abra Teleport",
    "asar": true,
    "files": [
      "dist-web/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../abra-teleport/dist/install.json",
        "to": "Runtime/wrapper/runtime/install.json"
      },
      {
        "from": "../abra-teleport/bin",
        "to": "Runtime/wrapper/bin"
      },
      {
        "from": "../abra-teleport/src",
        "to": "Runtime/wrapper/src"
      },
      {
        "from": "../abra-teleport/adapters",
        "to": "Runtime/wrapper/adapters"
      },
      {
        "from": "../abra-teleport/scripts",
        "to": "Runtime/wrapper/scripts"
      },
      {
        "from": "../abra-teleport/package.json",
        "to": "Runtime/wrapper/package.json"
      },
      {
        "from": "../abra/target/release/abra",
        "to": "Runtime/abra"
      },
      {
        "from": "../abra/adapters/browser-session/bin",
        "to": "Runtime/browser-session/bin"
      },
      {
        "from": "../abra/adapters/browser-session/facade",
        "to": "Runtime/browser-session/facade"
      },
      {
        "from": "../abra/adapters/browser-session/lib",
        "to": "Runtime/browser-session/lib"
      },
      {
        "from": "../abra/adapters/browser-session/abra-adapter.json",
        "to": "Runtime/browser-session/abra-adapter.json"
      },
      {
        "from": "../abra/adapters/browser-session/package.json",
        "to": "Runtime/browser-session/package.json"
      },
      {
        "from": "../abra/adapters/lib",
        "to": "Runtime/lib"
      },
      {
        "from": "../abra/adapters/sandbox/collector/observer.py",
        "to": "Runtime/observer.py"
      },
      {
        "from": "../abra-teleport/dist/abra-teleport-agent.tar.gz",
        "to": "abra-teleport-agent.tar.gz"
      }
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Abra Teleport reads the titles and URLs of your open Chrome tabs so you can choose what to move."
      }
    }
  }
}
